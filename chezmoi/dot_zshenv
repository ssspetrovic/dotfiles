export EDITOR="vim"
export VISUAL="vim"
export PAGER="less"

# Homebrew across macOS, Linuxbrew's shared prefix, and user-local Linuxbrew.
if (( ${+commands[brew]} )); then
  eval "$(brew shellenv)"
else
  for brew_bin in \
    /opt/homebrew/bin/brew \
    /usr/local/bin/brew \
    /home/linuxbrew/.linuxbrew/bin/brew \
    "$HOME/.linuxbrew/bin/brew"; do
    if [[ -x "$brew_bin" ]]; then
      eval "$("$brew_bin" shellenv)"
      break
    fi
  done
  unset brew_bin
fi
